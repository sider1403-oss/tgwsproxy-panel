# Copy to /etc/tgws-panel.env and adjust for your host.
PANEL_PUBLIC_HOST=192.168.1.10
PANEL_PORT=8090

TGWS_PROXY_PORT=1443
TGWS_PANEL_ROOT=/opt/tgws-panel
TGWS_PROXY_DIR=/opt/tg-ws-proxy
TGWS_CONTAINER=tgwsproxy
TGWS_SERVICE=tgwsproxy
TGWS_SNIFF_IFACE=eth0

# Session lifetime
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Reverse proxy: trust X-Forwarded-* only from this address and allow its origin.
# PANEL_TRUSTED_PROXIES=127.0.0.1
# PANEL_ALLOWED_ORIGINS=https://panel.example.com
